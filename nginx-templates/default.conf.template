# Map the browser-sent X-Pexels-Key header (from config.json) to a full
# "Bearer <key>" Authorization header. Empty string when no key is sent,
# so nginx doesn't emit a malformed empty Authorization header (which
# Pexels rejects with 401 — worse than sending nothing).
map $http_x_pexels_key $pexels_auth_header {
    default "Bearer $http_x_pexels_key";
    ""      "";
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Dashboard config from persistent volume
    location = /config.json {
        alias /data/config.json;
        default_type application/json;
        add_header Cache-Control "no-store";
    }

    # Blockchain.com pass-through for long-range price history:
    # /api/bc/market-price?... -> https://api.blockchain.info/charts/market-price?...
    location /api/bc/ {
        proxy_pass https://api.blockchain.info/charts/;
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_read_timeout 15s;
        proxy_set_header Host api.blockchain.info;
    }

    # Pexels API pass-through for background images:
    # /api/pexels/search?... -> https://api.pexels.com/v1/search?...
    # The browser sends the API key (which it read from config.json) as the
    # X-Pexels-Key header; a map translates it to the Authorization header
    # Pexels expects. Falls back to the env-injected key when no header is
    # sent. The key never appears in URLs or logs.
    location /api/pexels/ {
        proxy_pass https://api.pexels.com/v1/;
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_read_timeout 15s;
        proxy_set_header Host api.pexels.com;
        proxy_set_header Authorization $pexels_auth_header;
    }

    # CoinGecko pass-through for chart + historical endpoints:
    # /api/cg/coins/bitcoin/... -> https://api.coingecko.com/api/v3/...
    location /api/cg/ {
        proxy_pass https://api.coingecko.com/api/v3/;
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_read_timeout 15s;
        proxy_set_header Host api.coingecko.com;
    }

    # Configured price source, resolved by main.ts into PRICE_UPSTREAM
    location /api/price {
        proxy_pass ${PRICE_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_read_timeout 15s;
        proxy_set_header Host ${PRICE_HOST};
    }

    # Cache static assets
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # Never cache HTML
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-store";
    }
}
